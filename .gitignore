# Generated by Cargo
/target/
/target-*

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# IDE specific files
*.swp
*.swo

# Build artifacts
/build/
/dist/
/out/
/tmp/
/.claude/

# Local environment files
.env
.env.local

# Prepared WebAssembly payloads and what their preparation writes into the checkout are never
# tracked (zuper-wasm: ZW-LAYOUT-IGNORED, ZW-NEVER-COMMITTED)
**/assets/wasm/
/.zuper/wasm-prepare.lock
/.zuper/wasm-staging/
/.zuper/wasm-target/
/.zuper/wasm-dx/

